# ── SilverCare — Railway environment variables ─────────────────────────────
# Copy these into Railway → your service → Variables.
# Railway provides PORT automatically; do NOT set it manually.
# DO NOT commit a real .env file — it is git-ignored.
#
# Where each value comes from:
#  • EMAIL_USER / EMAIL_PASS — Gmail address + Gmail "App password"
#    (Google Account → Security → 2-Step Verification → App passwords).
#    A normal Gmail password will NOT work.
#  • FIREBASE_* — Firebase Console → Project settings → General →
#    "Your apps" → Web app config (same values as your local .env).
#  • FIREBASE_DATABASE_URL — Realtime Database URL, e.g.
#    https://silvercare-a89e6-default-rtdb.asia-southeast1.firebasedatabase.app
#    (Firebase Console → Build → Realtime Database → URL shown at the top).
#    For this project it MUST be the asia-southeast1 URL — the
#    default-region fallback (…-default-rtdb.firebaseio.com) is wrong.
#  • SERVICE_ACCOUNT_JSON — the ENTIRE serviceAccountKey.json content pasted
#    as ONE LINE (Firebase Console → Project settings → Service accounts →
#    Generate new private key). No newlines — the whole JSON on a single line.
#  • SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY — Supabase Dashboard →
#    Project Settings → API (URL + service_role key, NOT the anon key).
#  • QR_SECRET — any long random string, e.g. output of:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  • PUBLIC_BASE_URL — your Railway public URL, e.g.
#    https://silvercare-production.up.railway.app (no trailing slash).
#    Used for password-reset links in admin emails and for CORS.

# ── Deployment identity (REQUIRED for production links/CORS) ──
# Your Railway public URL, e.g. https://silvercare-production.up.railway.app
PUBLIC_BASE_URL=

# ── Deployment mode ──
# Set to "production" on Railway. This activates production CORS behavior
# (dev-only localhost origins are disabled) — safe even if you forget.
# NODE_ENV=production

# ── Firebase Admin (server) ────────────────────────────────────
# Paste the ENTIRE serviceAccountKey.json content on ONE line.
SERVICE_ACCOUNT_JSON=
# NOTE: for this project FIREBASE_DATABASE_URL (in the web-config section
# below) is REQUIRED anyway — the database lives in asia-southeast1, so the
# default-region fallback URL built from the project ID alone would point
# at the wrong region. Set it there, not here.

# ── Firebase Web config (served to the browser at /js/firebase-config.js) ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_DATABASE_URL=

# ── Gmail SMTP (OTP + notice + reset e-mails) ──────────────────
# Use a Gmail App Password, NOT your normal Gmail password.
EMAIL_USER=
EMAIL_PASS=

# ── Supabase (private medical-document vault) ──────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── QR verification signing secret (REQUIRED — set a long random string) ──
QR_SECRET=

# ── Optional extra allowed origins (comma-separated, no trailing slash) ──
# ALLOWED_ORIGINS=https://your-custom-domain.com
