# ══════════════════════════════════════════════════════════════════
# SilverCare — Environment Variable Guide (NO SECRETS in this file)
# Copy this file to `.env` locally, then fill in YOUR real values.
# On Railway: Service → Variables → add each variable listed below.
# NEVER commit `.env` or `serviceAccountKey.json` (both are git-ignored).
# ══════════════════════════════════════════════════════════════════
#
# ── How to find each value ───────────────────────────────────────
#  • SERVICE_ACCOUNT_JSON — Firebase Console → Project settings →
#    Service accounts → Generate new private key → paste ENTIRE JSON
#    on ONE line (keep \n inside private_key as literal \n).
#  • FIREBASE_* — Firebase Console → Project settings → General →
#    Your web app config (public values, also in public/js/firebase-config.js).
#  • FIREBASE_DATABASE_URL — Realtime Database URL, e.g.
#    https://silvercare-a89e6-default-rtdb.asia-southeast1.firebasedatabase.app
#    (Firebase Console → Build → Realtime Database → URL shown at the top).
#    For this project it MUST be the asia-southeast1 URL — the
#    default-region fallback (…-default-rtdb.firebaseio.com) is wrong.
#  • EMAIL_USER / EMAIL_PASS — Gmail address + Gmail APP password
#    (Google Account → Security → 2-Step Verification → App passwords).
#  • SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY — Supabase Dashboard →
#    Project Settings → API → Project URL + service_role key (NOT anon).
#    Then run scripts/supabase-setup.sql once in the Supabase SQL Editor.
#  • QR_SECRET — any long random string. Generate one with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  • PUBLIC_BASE_URL — your Railway public URL, no trailing slash, e.g.
#      https://silver-production-xxxx.up.railway.app

# ── Deployment identity (REQUIRED for production links/CORS) ──
# Your Railway public URL, e.g. https://silvercare-production.up.railway.app
PUBLIC_BASE_URL=

# ── Deployment mode ──
# Set to "production" on Railway. This activates production CORS behavior
# (dev-only localhost origins are disabled) — safe even if you forget.
# NODE_ENV=production

# ── Firebase Admin (server) ────────────────────────────────────
# Paste the ENTIRE serviceAccountKey.json content on ONE line.
SERVICE_ACCOUNT_JSON=
# NOTE: for this project FIREBASE_DATABASE_URL (in the web-config section
# below) is REQUIRED anyway — the database lives in asia-southeast1, so the
# default-region fallback URL built from the project ID alone would point
# at the wrong region. Set it there, not here.

# ── Firebase Web config (served at /js/firebase-config.js) ────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# REQUIRED for this project — must be the asia-southeast1 URL:
# https://silvercare-a89e6-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# ── Gmail SMTP (OTP + notices + reset links) ───────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Supabase (senior data mirror + ID/medical vaults) ──────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── QR verification ────────────────────────────────────────────
QR_SECRET=

# ── Optional: extra allowed origins (comma-separated) ──────────
# ALLOWED_ORIGINS=https://your-custom-domain.com
